# --- Database (Vercel Postgres / Neon) ---
# When you create a Vercel Postgres store and connect it to the project,
# Vercel injects POSTGRES_URL automatically. For local dev, paste the URL here
# into a file named .env.local
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# --- Auth ---
# A long random string used to sign login sessions.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
